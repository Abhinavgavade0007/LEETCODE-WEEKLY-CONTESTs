#1 3726. Remove Zeros in Decimal Representation
class Solution {
public:
    long long removeZeros(long long n) {
        // string temp=to_string()
        if(n == 1) return 1;
        long long newans=0;
        while(n) {
            int rem=n%10;
            if(rem != 0) {
                newans=newans*10+rem;
            }
            // else if(rem == 0) {}
            n=n/10;
        }
        long long finalans=0;
        while(newans) {
            int rem=newans%10;
            finalans=finalans*10+rem;
            newans/=10;
        }
        return finalans;
    }
};

#2 3727. Maximum Alternating Sum of Squares
class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        int n=nums.size();
        for(int &it:nums) {
            it=it*it;
        }
        sort(nums.begin(),nums.end());
        long long ans=0;
        for(int i=0;i<n/2;i++) {
            ans-=nums[i];
        }
        for(int i=n/2;i<n;i++) {
            ans+=nums[i];
        }
        return ans;
    }
};
